# Local demonstration. No external model calls.
MODEL_MODE=demo
COOKIE_SECURE=false
EMBEDDED_WORKER=true
# Override with postgresql+psycopg://user:password@localhost:5432/salon when needed.
# DATABASE_URL=
# DATA_DIR=

# Real mode requires explicitly configured administrator credentials.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
VISION_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VISION_MODEL=qwen3-vl-plus
IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
# Confirmed model: Seedream 5.0 Flash. No silent substitution.
IMAGE_MODEL=doubao-seedream-5-0-flash-260915
DASHSCOPE_API_KEY=
ARK_API_KEY=
# OPTIONAL administrator settings. Leave all three blank to use the agreed
# image-count limit only (18 attempts per consultation, at most 9 delivery images).
# Unknown costs remain unknown, never treated as free.
IMAGE_ATTEMPT_PRICE_CNY=
VISION_CALL_RESERVE_CNY=
CONSULTATION_BUDGET_CNY=
