{
  "name": "salon-cloudflare-native",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1 --port 8787 --persist-to ../../.runtime/cloudflare-native",
    "migrate:local": "wrangler d1 execute salon-native --config wrangler.local.jsonc --local --file migrations/0001.sql --persist-to ../../.runtime/cloudflare-native",
    "check": "wrangler deploy --dry-run --outdir ../../.runtime/cloudflare-native-build"
  },
  "devDependencies": {
    "wrangler": "^4.160.0"
  }
}