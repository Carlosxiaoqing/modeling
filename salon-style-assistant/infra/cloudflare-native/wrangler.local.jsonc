{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salon-style-assistant",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salon-native",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "salon-style-private"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "salon-style-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "salon-style-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 0
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "VISION_ENDPOINT": "https://llm-dho81kzt15bmlomf.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions",
    "VISION_MODEL": "qwen3-vl-plus",
    "IMAGE_MODEL": "doubao-seedream-5-0-flash-260915",
    "STORAGE_PROVIDER": "local-r2"
  },
  "observability": {
    "enabled": false
  }
}